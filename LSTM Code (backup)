#create sequences using the previous 24 hours
window_size = 24
def create_sequences(data_x, data_y, window_size):
    x, y = [], []
    for i in range(window_size, len(data_x)):
        x.append(data_x[i-window_size:i])
        y.append(data_y[i])
    return np.array(x), np.array(y)

